# Env de ejemplo — copia a .env.local y rellena con tus credenciales

# --- Supabase (obligatorio) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY
# Solo servidor (cron / ingesta). NUNCA exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY

# --- Proveedores de cuotas (odds) ---
# https://the-odds-api.com — plan gratuito: 500 peticiones/mes.
# OJO: el coste es (mercados x regiones) por llamada, no una por llamada.
THE_ODDS_API_KEY=
# Opcionales; estos son los valores por defecto.
# Las competiciones se configuran en codigo (src/lib/competitions.ts), no aqui.
# Ampliar cualquiera de estos dos multiplica el gasto de cuota: 'uk' trae sobre
# todo casas donde no se puede apostar desde Espana.
ODDS_REGIONS=eu
ODDS_MARKETS=h2h
# https://developer.betfair.com (Exchange API-NG)
BETFAIR_APP_KEY=
BETFAIR_USERNAME=
BETFAIR_PASSWORD=

# --- Proveedores de estadisticas ---
# https://www.api-football.com  (via api-sports.io o RapidAPI)
API_FOOTBALL_KEY=
# https://www.football-data.org (free tier)
FOOTBALL_DATA_ORG_KEY=
# https://my.sportmonks.com
SPORTMONKS_KEY=

# --- Datos auxiliares ---
# http://api.clubelo.com (gratis, sin key)
OPENWEATHER_API_KEY=

# --- Seguridad de cron / ingesta ---
# Debe coincidir con el secreto CRON_SECRET del repositorio en GitHub, que es
# quien dispara la ingesta (ver .github/workflows/ingest-odds.yml).
CRON_SECRET=
